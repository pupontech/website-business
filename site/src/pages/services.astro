---
import AgencyDraftLayout from "../layouts/AgencyDraftLayout.astro";
---
<AgencyDraftLayout title="Services — private draft">
  <section class="intro">
    <p class="eyebrow">02 / Draft services</p>
    <h1>Services — private draft</h1>
    <p class="lede">Service areas under consideration — scope and capability not yet confirmed.</p>
  </section>
  <section class="content-block" aria-label="Unverified planning categories">
    <p class="section-kicker">Planning labels only · not an offer</p>
    <div class="service-grid">
      <article class="service-card"><span class="card-index">01</span><h2>Astro static</h2><p>[Service scope — content needed]</p></article>
      <article class="service-card"><span class="card-index">02</span><h2>Astro CMS</h2><p>[Service scope — content needed]</p></article>
    </div>
  </section>
</AgencyDraftLayout>
