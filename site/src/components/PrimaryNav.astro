---
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/contact/", label: "Contact" },
];
const current = Astro.url.pathname;
---
<nav aria-label="Primary">
  <ul class="nav-list">
    {links.map(({ href, label }) => (
      <li><a href={href} aria-current={current === href ? "page" : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>
