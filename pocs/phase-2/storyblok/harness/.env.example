# P2.5 Storyblok harness — environment template.
#
# Every value in this template is an invented placeholder. No real Storyblok
# account, space, token, or credential exists in this POC, and none may be
# committed (AGENTS.md §Security).
#
# The official guide's setup expects STORYBLOK_DELIVERY_API_TOKEN in .env.
STORYBLOK_DELIVERY_API_TOKEN=poc-test-invented-placeholder

# Harness-only deviation: point the official client at the local mock CDN
# (apiOptions.endpoint, an official storyblok-js-client config field).
STORYBLOK_POC_ENDPOINT=http://127.0.0.1:4399/v2
